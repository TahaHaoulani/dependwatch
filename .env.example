# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dependwatch?schema=public"

# Auth (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
# Production: set to https://your-domain.com so session cookies are secure and sessions persist correctly
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Sessions: 30-day max, rolling (extended on use). Secure cookies when NEXTAUTH_URL is https.
# OAuth (optional; buttons shown only when both ID and secret are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Magic-link email: use SendGrid SMTP (recommended) or Resend
# SendGrid SMTP (recommended)
SENDGRID_API_KEY="SG.xxx"
# Or generic SMTP (e.g. SendGrid: host smtp.sendgrid.net, port 587, user apikey)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxx"
# Fallback if SMTP not set (Resend API)
AUTH_RESEND_KEY=""
EMAIL_FROM="DependWatch <noreply@yourdomain.com>"
# Contact form: messages are sent here (default support@dependwatch.app if unset)
CONTACT_EMAIL=""

# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STRIPE_PRICE_BUILDER="price_xxx"
STRIPE_PRICE_STARTUP="price_xxx"

# Ingestion (for SDK: base URL; for sample script: use INGEST_URL)
DEPENDWATCH_INGEST_URL="http://localhost:3000"
# Sample script: set DEPENDWATCH_INGEST_KEY to your project ingest key, INGEST_URL to app URL (default localhost:3000)

# Logo.dev (company logos by domain on landing/pricing; get key at https://www.logo.dev)
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=""

# Landing page mode: "product" (full signup/dashboard) or "waitlist" (early access email capture).
# Default: product. Set to waitlist to show Join Early Access CTAs and hero email form.
# NEXT_PUBLIC_LANDING_MODE="product"
# NEXT_PUBLIC_LANDING_MODE="waitlist"

# PostHog (optional): product analytics for acquisition, activation, and retention
# Leave empty to disable; app runs normally without analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# NEXT_PUBLIC_POSTHOG_DEBUG="1"  # log events in dev console when set

# MFA (optional): 32-character key to encrypt TOTP secrets at rest; if unset, secrets are stored in plaintext
MFA_ENCRYPTION_KEY=""

# Redis (optional): cache, rate limiting, and distributed locks. If unset, app uses in-memory fallbacks (single-instance only).
# Set REDIS_URL (and optionally REDIS_ENABLED=true) for production or multi-instance.
#REDIS_URL=""
#REDIS_PREFIX="dw"
#REDIS_ENABLED="true"
#CACHE_DEFAULT_TTL_SECONDS="45"

# Cron (optional): secret for protecting cron endpoints (overage-billing, scheduler). Send as Bearer token or x-cron-secret header.
CRON_SECRET=""

# MCP (optional): no extra env required; MCP endpoint is POST /api/mcp with Bearer token from dashboard
# NEXT_PUBLIC_APP_URL is used in MCP setup UI for copyable config snippets (defaults to origin in browser)
